# Copy to .env or export in your shell. Never commit real values.
# Real keys can also live in ~/.config/hackathon/secrets.env (loaded automatically if present).

# 0 = replay fixtures from fixtures/ (default, no keys needed); 1 = real API calls
LIVE=0

# NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily search (official-source verification)
TAVILY_API_KEY=
